# Copy to .env.local (never committed) and fill in. On Vercel: Project → Settings → Environment Variables.

# --- Supabase (Dashboard → Project Settings → API) ---
# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
# "service_role" secret key (or a new-style "sb_secret_..." key). Server only: never expose it in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (resend.com → API Keys) ---
RESEND_API_KEY=
# Sender. Must be on a domain verified in Resend. Until the domain is verified you can test with
# "Clara <onboarding@resend.dev>", which only delivers to the address of your own Resend account.
EMAIL_FROM="Clara <hello@claralimpezas.com>"
# Inbox that receives the team notifications (new request, client message, quote accepted).
TEAM_EMAIL=

# --- CRM (/admin) ---
# Password for the team space. Use a long one.
ADMIN_PASSWORD=

# --- Daily automations (quote follow-up, day-before reminder) ---
# Random string; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>" to /api/cron/daily.
CRON_SECRET=

# --- Site ---
# Public URL used in canonical/OG links and in the links sent by e-mail.
# NEXT_PUBLIC_SITE_URL=https://www.claralimpezas.com
# GOOGLE_SITE_VERIFICATION=
